import json
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from contract_enforcement import ContractEnforcementLayer


class TestContractEnforcementLayer(unittest.TestCase):
    def load_case(self, path):
        with open(ROOT / path, "r", encoding="utf-8") as file:
            return json.load(file)

    def test_allowed_attempt_within_contract(self):
        layer = ContractEnforcementLayer()
        result = layer.enforce(
            self.load_case("contract_enforcement/sample_contract.json"),
            self.load_case("contract_enforcement/sample_attempt_allowed.json")
        )
        self.assertTrue(result["within_contract"])
        self.assertEqual(result["enforcement_decision"], "GO")

    def test_violation_attempt_outside_contract(self):
        layer = ContractEnforcementLayer()
        result = layer.enforce(
            self.load_case("contract_enforcement/sample_contract.json"),
            self.load_case("contract_enforcement/sample_attempt_violation.json")
        )
        self.assertFalse(result["within_contract"])
        self.assertGreater(len(result["violations"]), 0)


if __name__ == "__main__":
    unittest.main()
