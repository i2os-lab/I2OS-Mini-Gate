{
  "policy_name": "I2OS Mini Gate Permissive Policy",
  "policy_version": "v1.7-permissive",
  "core_principle": "Capability is not permission.",
  "allowed_permission_levels": [
    "read_only",
    "user",
    "admin"
  ],
  "permission_levels": {
    "unknown": -1,
    "read_only": 0,
    "user": 1,
    "admin": 2
  },
  "broad_scopes": [
    "all_files",
    "system",
    "all_users"
  ],
  "dangerous_keywords": [
