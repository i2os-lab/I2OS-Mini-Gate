    "remove",
    "erase",
    "wipe",
    "upload",
    "export",
    "execute",
    "rm -rf",
    "shutdown"
  ],
  "untrusted_sources": [
    "untrusted_document",
    "untrusted_input",
    "external_content",
    "web_page",
    "email_body",
    "pdf_content"
  ],
  "external_keywords": [
    "upload",
    "send",
    "export",
    "post",
    "external",
    "api"
  ],
  "destructive_side_effect_levels": [
    "destructive",
    "irreversible"
  ],
  "critical_reason_codes": [
    "PROMPT_INJECTION_TRANSITION",
    "PERMISSION_ESCALATION_ATTEMPT",
    "DESTRUCTIVE_TOOL_SCOPE_COMBINATION",
    "DELETE_NOT_RECOVERABLE"
  ],
  "high_reason_codes": [
    "UNTRUSTED_EXTERNAL_SIDE_EFFECT_REQUEST",
